{
  "name": "openhaul",
  "version": "0.1.0",
  "private": true,
  "description": "OpenHaul - free, self-hostable auto transport load management (TMS) for car haulers.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "keys:generate": "node scripts/generate-secrets.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/copy-wasm.mjs",
    "publish": "node scripts/publish-to-github.mjs"
  },
  "overrides": {
    "browserslist": "^4.28.7"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.2.1",
    "@serwist/next": "^9.5.12",
    "barcode-detector": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "exif-reader": "^2.0.3",
    "geist": "^1.7.2",
    "imapflow": "^2.0.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.9",
    "otpauth": "^9.5.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "serwist": "^9.5.12",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.4",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
