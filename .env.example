# Generated by scripts/generate-secrets.mjs
# Keep this file out of version control. chmod 600 it on a server.

# ---- database ----
# A local file by default. Point at libSQL/Turso by changing the URL.
DATABASE_URL="file:./data/openhaul.db"
# DATABASE_AUTH_TOKEN="REPLACE_ME"

# Whole-database encryption at rest. Protects a stolen disk or a copied
# backup. Losing this key means losing the database.
DATABASE_ENCRYPTION_KEY="REPLACE_ME"

# ---- field-level encryption ----
# Newest key first, comma separated: v2:<base64>,v1:<base64>
# Rotate by PREPENDING a new version. Old ciphertexts stay readable because
# every envelope names the version that sealed it.
OPENHAUL_KEYS="REPLACE_ME"

# Pinned separately from OPENHAUL_KEYS. Changing it invalidates every blind
# index and requires re-indexing those columns in the same migration.
OPENHAUL_INDEX_KEY_VERSION="1"

# ---- passwords ----
# Held outside the database, so a database dump alone is useless.
# Rotating this invalidates every password, so treat it as append-only.
PASSWORD_PEPPER="REPLACE_ME"

# ---- external data ----
# FMCSA carrier and broker lookups. Free, issued immediately at
# https://mobile.fmcsa.dot.gov/QCDevsite/home/register — no key, no lookups.
# NHTSA VIN decoding needs nothing; only this one does.
# FMCSA_WEB_KEY="REPLACE_ME"

# ---- sending documents ----
# Any mailbox you already have works. Without these, documents are still
# produced and downloadable; only sending from the app is off.
# On port 465 set SMTP_SECURE=true; on 587 leave it unset.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="dispatch@example.com"
# SMTP_PASSWORD="REPLACE_ME"
# SMTP_FROM="Ridgeline Auto Transport <dispatch@example.com>"
# SMTP_REPLY_TO="office@example.com"

# ---- reading bounces back ----
# Without these, a document that failed downstream goes on reading as
# accepted. Usually the same mailbox SMTP_FROM sends from; credentials fall
# back to the SMTP ones when omitted.
# IMAP_HOST="imap.example.com"
# IMAP_PORT="993"
# IMAP_USER="dispatch@example.com"
# IMAP_PASSWORD="REPLACE_ME"
# IMAP_MAILBOX="INBOX"

# Lets bounces be returned to a traceable address, so a failure can be matched
# to its send even when the returning server keeps none of the original
# headers. Must be a real mailbox that accepts plus-addressing.
# SMTP_BOUNCE_ADDRESS="bounces@example.com"

# Set to allow a cron line to POST /api/bounces/check without a session.
# Leave unset and that endpoint stays off entirely.
# BOUNCE_CHECK_TOKEN="REPLACE_ME"

# ---- sending statements on a schedule ----
# Set to allow a cron line to POST /api/statements/run without a session, and
# leave unset to keep that endpoint off entirely. The cadence itself is set in
# the app; this only lets something outside tell it what time it is.
#
#   0 6 * * * curl -fsS -X POST -H "authorization: Bearer $TOKEN" #     https://your-host/api/statements/run
#
# Safe to call more often than the cadence and safe to call late: an
# occurrence runs at most once, and a missed one is not made up.
# STATEMENT_RUN_TOKEN="REPLACE_ME"

# ---- application ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_REPO_URL="REPLACE_ME"

# Required when running more than one instance: Next.js encrypts values that
# Server Actions close over with a per-build key, and separate instances would
# otherwise generate different keys and fail intermittently.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="REPLACE_ME"

# Set when behind a reverse proxy that rewrites Host, or sign-in will fail
# with an origin mismatch. Also set `proxy_set_header X-Forwarded-Host $host;`
# ALLOWED_ORIGINS="REPLACE_ME"

# HSTS. Add includeSubDomains and preload only if you control every subdomain.
# HSTS_HEADER="REPLACE_ME"
